# Sao chép file này thành secrets.yaml rồi điền giá trị thật.
#   cp secrets.yaml.example secrets.yaml
#
# Chỉ còn 4 giá trị — thông tin dongle (IP + 2 serial) được thiết bị
# TỰ DÒ và TỰ HỌC khi chạy, không cần khai báo.

# Mật khẩu AP captive-portal khi thiết bị chưa có WiFi (>= 8 ký tự)
ap_password: "vlux12345"

# Mật khẩu OTA
ota_password: "change-me-ota"

# Đăng nhập trang web của thiết bị (http://<ip>/)
web_user: "admin"
web_password: "change-me-web"
